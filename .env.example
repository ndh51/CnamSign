# Identifiants Le Cnam (communs pour Outlook et CnamSignE)
EMAIL=prenom.nom.auditeur@lecnam.net
PASSWORD=ton_mot_de_passe

# Code PIN secret (saisi sur le clavier virtuel pour signer)
PIN_CODE=1234

# Dossier Outlook où sont déplacés les mails d'émargement (par défaut: Emargements)
OUTLOOK_FOLDER=Emargements

# Notifications Discord (optionnel)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Identifiant Discord pour recevoir une mention / ping (ex: 123456789012345678)
DISCORD_USER_ID=
# Nom ou pseudo de l'élève affiché dans la notification (optionnel)
STUDENT_NAME=

# Paramètres optionnels
# POLL_INTERVAL=30
# HEADLESS=true
